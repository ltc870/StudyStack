# StudyStack: nightly database backup (ops/backup-db.sh).
# Runs on homeserver, for production. Install as /etc/cron.d/studystack-backup, with no
# dot in the name: cron ignores files in /etc/cron.d whose names contain a dot.
#   sudo install -m 644 -o root -g root ops/studystack-backup.cron /etc/cron.d/studystack-backup
#
# homeserver's clock is Louisville time: 4:17 a.m. local all year, clear of the 1 to 3 a.m.
# hour that daylight saving time skips or repeats.
# The script logs to the journal itself; anything else it prints (such as a shell error)
# is sent there too, under the same tag. Read with: journalctl -t studystack-backup

SHELL=/bin/bash
PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin

# m  h  dom mon dow  user  command
17   4  *   *   *    root  /home/lawrence/applications/environments/production/studystack-prod/ops/backup-db.sh 2>&1 | logger -t studystack-backup
