# Copy this file to .env and fill in real values. Never commit .env.
# Read by docker-compose.prod.yml (the POSTGRES_ values are also used
# by docker-compose.yml for the local dev database).
# Generate each secret with: openssl rand -hex 32

# Postgres
POSTGRES_DB=studystack
POSTGRES_USER=studystack
POSTGRES_PASSWORD=change-me

# Signs the JWT access tokens. At least 32 characters.
JWT_SIGNING_KEY=change-me

# Address Caddy's port is published on. On the server, set it to the
# machine's Tailscale IP (tailscale ip -4). Leave it out locally (defaults to 127.0.0.1).
# CADDY_BIND_ADDRESS=100.x.y.z

# Caddy's site address. On the server, set it to the machine's MagicDNS name
# (for example studystack.tail63e067.ts.net); that turns on HTTPS. Leave it out
# locally (defaults to :80, plain HTTP on http://localhost).
# SITE_ADDRESS=<machine>.<tailnet>.ts.net
